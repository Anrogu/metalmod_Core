# ==========================================
# Configuración de la Base de Datos (PostgreSQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_seguro_aqui
POSTGRES_DB=metalmod_core

# ==========================================
# Configuración del Backend (Spring Boot)
# ==========================================
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/metalmod_core
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=tu_password_seguro_aqui

# ==========================================
# Respaldos automaticos por SSH
# ==========================================
RESPALDO_SSH_USUARIO=usuario_destino
RESPALDO_SSH_HOST=192.168.1.52
RESPALDO_SSH_DIRECTORIO=/home/usuario_destino/respaldos
RESPALDO_SSH_PUERTO=22
RESPALDO_SSH_LLAVE=/home/usuario/.ssh/id_ed25519_respaldos
RESPALDO_RETENCION_DIAS=30
RESPALDO_REMOTO_DIAS=90
